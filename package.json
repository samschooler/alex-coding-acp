{
  "name": "alex-coding-acp",
  "version": "0.1.0",
  "description": "Amazon Alexa for Shopping (Rufus) ACP coding agent & OpenCode AI SDK v3 ACP provider",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "alex-coding-acp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "acp": "tsx src/cli.ts acp",
    "serve": "tsx src/cli.ts serve",
    "login": "tsx src/cli.ts login",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.12.0",
    "@ai-sdk/provider": "3.0.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
